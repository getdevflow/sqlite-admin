<?php

use App\Shared\Services\Registry;

use function App\Shared\Helpers\admin_url;
use function Qubus\Security\Helpers\esc_html;
use function Qubus\Security\Helpers\esc_html__;

$this->parent('plugin::SqliteAdmin/view/layout');
$this->block('sqlite-admin', function ($params) {

$r = Registry::getInstance()->get('sqlite-admin');
$tableCount = count($params['tables'] ?? []);
?>

<section class="df-sqlite-card">
    <header class="df-sqlite-card-header">
        <div>
            <h2><?=esc_html__('Export Database', $r['id']);?></h2>
            <p><?=esc_html__('Download a SQL or CSV export of the SQLite database.', $r['id']);?></p>
        </div>

        <div class="df-sqlite-actions">
            <a class="button" href="<?= admin_url('plugin/sqlite-admin/'); ?>">
                <?=esc_html__('Dashboard', $r['id']);?>
            </a>

            <a class="button" href="<?= admin_url('plugin/sqlite-admin/sql'); ?>">
                <?=esc_html__('SQL Editor', $r['id']);?>
            </a>
        </div>
    </header>

    <div class="df-sqlite-card-body">
        <div class="df-sqlite-panel">
            <h3><?=esc_html__('Export Options', $r['id']);?></h3>

            <form
                    method="post"
                    action="<?= admin_url('plugin/sqlite-admin/export'); ?>"
                    class="df-sqlite-form"
            >

                <div class="df-sqlite-form-grid">
                    <label>
                        <?=esc_html__('Export Format', $r['id']);?>

                        <select name="format" required>
                            <option value="sql" selected>
                                <?=esc_html__('SQL Dump', $r['id']);?> (.sql)
                            </option>

                            <option value="csv">
                                <?=esc_html__('CSV Export', $r['id']);?> (.csv)
                            </option>
                        </select>

                        <small>
                            <?=esc_html__('SQL preserves schema and data. CSV exports table rows.', $r['id']);?>
                        </small>
                    </label>

                    <label>
                        <?=esc_html__('Export Scope', $r['id']);?>

                        <select name="scope">
                            <option value="database" selected>
                                <?=esc_html__('Entire Database', $r['id']);?>
                            </option>

                            <option value="tables">
                                <?=esc_html__('Selected Tables', $r['id']);?>
                            </option>
                        </select>

                        <small>
                            <?=esc_html__('Export all visible tables or only selected tables.', $r['id']);?>
                        </small>
                    </label>
                </div>

                <?php if (($params['tables'] ?? []) !== []): ?>
                    <fieldset class="df-sqlite-fieldset">
                        <legend><?=esc_html__('Select Tables', $r['id']);?></legend>

                        <div class="df-sqlite-checkbox-grid">
                            <?php foreach ($params['tables'] as $item): ?>
                                <?php
                                $name = (string) ($item['name'] ?? '');
                                $type = (string) ($item['type'] ?? 'table');
                                ?>

                                <label class="df-sqlite-checkbox">
                                    <input
                                            type="checkbox"
                                            name="tables[]"
                                            value="<?= esc_html($name); ?>"
                                    >

                                    <span>
                                        <strong><?= esc_html($name); ?></strong>
                                        <small><?= esc_html(ucfirst($type)); ?></small>
                                    </span>
                                </label>
                            <?php endforeach; ?>
                        </div>
                    </fieldset>
                <?php endif; ?>

                <div class="df-sqlite-form-actions">
                    <button type="submit" id="df-sqlite-export-button">
                        <?=esc_html__('Export Database', $r['id']);?>
                    </button>
                </div>
            </form>
        </div>

        <div class="df-sqlite-panel">
            <h3><?=esc_html__('Export Information', $r['id']);?></h3>

            <dl class="df-sqlite-meta">
                <dt><?=esc_html__('Visible Objects', $r['id']);?></dt>
                <dd><?= esc_html((string) $tableCount); ?></dd>

                <dt><?=esc_html__('SQL Export', $r['id']);?></dt>
                <dd>
                    <?=esc_html__('Includes schema definitions and INSERT statements.', $r['id']);?>
                </dd>

                <dt><?=esc_html__('CSV Export', $r['id']);?></dt>
                <dd>
                    <?=esc_html__('Exports row data in CSV format.', $r['id']);?>
                </dd>

                <dt><?=esc_html__('Permissions', $r['id']);?></dt>
                <dd>
                    <?=esc_html__('Export visibility respects Devflow multisite table scoping.', $r['id']);?>
                </dd>
            </dl>
        </div>
    </div>

    <script>
        const scope = document.querySelector('select[name="scope"]');
        const button = document.querySelector('#df-sqlite-export-button');

        if (scope && button) {
            const updateExportLabel = () => {
                button.textContent = scope.value === 'tables'
                    ? <?=esc_html__('Export Selected Tables', $r['id']);?>
                    : <?=esc_html__('Export Database', $r['id']);?>;
            };

            scope.addEventListener('change', updateExportLabel);
            updateExportLabel();
        }
    </script>
</section>
<?php }); ?>
