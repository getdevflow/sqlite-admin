<?php

use App\Shared\Services\Registry;

use function App\Shared\Helpers\admin_url;
use function Qubus\Security\Helpers\esc_html;
use function Qubus\Security\Helpers\esc_html__;

$this->parent('plugin::SqliteAdmin/view/layout');
$this->block('sqlite-admin', function ($params) {
$r = Registry::getInstance()->get('sqlite-admin');
$objects = $params['tables'] ?? [];

$tableCount = 0;
$viewCount = 0;

foreach ($objects as $object) {
    if (($object['type'] ?? '') === 'view') {
        $viewCount++;
    } else {
        $tableCount++;
    }
}
?>

<section class="df-sqlite-card">
    <header class="df-sqlite-card-header">
        <div>
            <h2><?=esc_html__('Database Structure', $r['id']);?></h2>
            <p><?=esc_html__('Tables and views visible to the current user.', $r['id']);?></p>
        </div>

        <div class="df-sqlite-actions">
            <a class="button" href="<?= admin_url('plugin/sqlite-admin/'); ?>"><?=esc_html__('Dashboard', $r['id']);?></a>
            <a class="button" href="<?= admin_url('plugin/sqlite-admin/sql'); ?>"><?=esc_html__('SQL Editor', $r['id']);?></a>
        </div>
    </header>

    <div class="df-sqlite-card-body">
        <div class="df-sqlite-stats-grid">
            <div class="df-sqlite-stat">
                <span class="df-sqlite-stat-label"><?=esc_html__('Tables', $r['id']);?></span>
                <strong><?= esc_html((string) $tableCount); ?></strong>
            </div>

            <div class="df-sqlite-stat">
                <span class="df-sqlite-stat-label"><?=esc_html__('Views', $r['id']);?></span>
                <strong><?= esc_html((string) $viewCount); ?></strong>
            </div>

            <div class="df-sqlite-stat">
                <span class="df-sqlite-stat-label"><?=esc_html__('Total Objects', $r['id']);?></span>
                <strong><?= esc_html((string) count($objects)); ?></strong>
            </div>
        </div>

        <div class="df-sqlite-panel">
            <h3><?=esc_html__('Database Objects', $r['id']);?></h3>

            <?php if ($objects === []): ?>
                <div class="df-sqlite-empty">
                    <p><?=esc_html__('No tables or views were found.', $r['id']);?></p>
                </div>
            <?php else: ?>
                <div class="df-sqlite-table-wrap">
                    <table class="df-sqlite-grid">
                        <thead>
                        <tr>
                            <th><?=esc_html__('Name', $r['id']);?></th>
                            <th><?=esc_html__('Type', $r['id']);?></th>
                            <th><?=esc_html__('Create SQL', $r['id']);?></th>
                            <th><?=esc_html__('Actions', $r['id']);?></th>
                        </tr>
                        </thead>

                        <tbody>
                        <?php foreach ($objects as $object): ?>
                            <?php
                            $name = (string) ($object['name'] ?? '');
                            $type = (string) ($object['type'] ?? 'table');
                            $createSql = (string) ($object['sql'] ?? '');
                            ?>

                            <tr>
                                <td>
                                    <strong><?= esc_html($name); ?></strong>
                                </td>

                                <td>
                                        <span class="df-sqlite-badge">
                                            <?= esc_html(ucfirst($type)); ?>
                                        </span>
                                </td>

                                <td>
                                    <?php if ($createSql !== ''): ?>
                                        <details>
                                            <summary><?=esc_html__('View SQL', $r['id']);?></summary>
                                            <pre class="df-sqlite-code"><code><?= esc_html($createSql); ?></code></pre>
                                        </details>
                                    <?php else: ?>
                                        <span class="df-sqlite-muted">N/A</span>
                                    <?php endif; ?>
                                </td>

                                <td>
                                    <div class="df-sqlite-row-actions">
                                        <a href="<?= admin_url('plugin/sqlite-admin/table/' . rawurlencode($name)); ?>">
                                            <?=esc_html__('Browse', $r['id']);?>
                                        </a>

                                        <a href="<?= admin_url('plugin/sqlite-admin/table/' . rawurlencode($name) . '/structure'); ?>">
                                            <?=esc_html__('Structure', $r['id']);?>
                                        </a>

                                        <a href="<?= admin_url('plugin/sqlite-admin/table/' . rawurlencode($name) . '/sql'); ?>">
                                            SQL
                                        </a>

                                        <a href="<?= admin_url('plugin/sqlite-admin/table/' . rawurlencode($name) . '/export'); ?>">
                                            <?=esc_html__('Export', $r['id']);?>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                        </tbody>
                    </table>
                </div>
            <?php endif; ?>
        </div>
    </div>
</section>
<?php }); ?>
