<?php

use App\Shared\Services\Registry;

use function App\Shared\Helpers\admin_url;
use function Qubus\Security\Helpers\esc_html;
use function Qubus\Security\Helpers\esc_html__;

$this->parent('plugin::SqliteAdmin/view/layout');
$this->block('sqlite-admin', function ($params) {
$r = Registry::getInstance()->get('sqlite-admin');
?>
<section class="df-sqlite-card">
    <header class="df-sqlite-card-header">
        <div>
            <h2><?=esc_html__('Indexes:', $r['id']);?> <?= esc_html($params['table']); ?></h2>
            <p><?=esc_html__('Create, inspect, and drop indexes for this table.', $r['id']);?></p>
        </div>
    </header>

    <div class="df-sqlite-panel">
        <h3><?=esc_html__('Existing Indexes', $r['id']);?></h3>

        <?php if ($params['indexes'] === []): ?>
            <p><?=esc_html__('No indexes found for this table.', $r['id']);?></p>
        <?php else: ?>
            <div class="df-sqlite-table-wrap">
                <table class="df-sqlite-grid">
                    <thead>
                    <tr>
                        <th><?=esc_html__('Name', $r['id']);?></th>
                        <th><?=esc_html__('Unique', $r['id']);?></th>
                        <th><?=esc_html__('Origin', $r['id']);?></th>
                        <th><?=esc_html__('Partial', $r['id']);?></th>
                        <th><?=esc_html__('Action', $r['id']);?></th>
                    </tr>
                    </thead>
                    <tbody>
                    <?php foreach ($params['indexes'] as $index): ?>
                        <tr>
                            <td><?= esc_html($index['name'] ?? ''); ?></td>
                            <td><?= ! empty($index['unique']) ? 'Yes' : 'No'; ?></td>
                            <td><?= esc_html((string) ($index['origin'] ?? '')); ?></td>
                            <td><?= ! empty($index['partial']) ? 'Yes' : 'No'; ?></td>
                            <td>
                                <?php if (($index['origin'] ?? '') === 'c'): ?>
                                    <form method="post" action="<?= admin_url('plugin/sqlite-admin/table/' . rawurlencode($params['table']) . '/indexes/drop'); ?>">
                                        <input type="hidden" name="index_name" value="<?= esc_html($index['name']); ?>">
                                        <button type="submit" onclick="return confirm(<?=esc_html__('Drop this index?', $r['id']);?>)">
                                            <?=esc_html__('Drop', $r['id']);?>
                                        </button>
                                    </form>
                                <?php else: ?>
                                    <span><?=esc_html__('System index', $r['id']);?></span>
                                <?php endif; ?>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>
            </div>
        <?php endif; ?>
    </div>

    <div class="df-sqlite-panel">
        <h3><?=esc_html__('Create Index', $r['id']);?></h3>

        <form method="post" action="<?= admin_url('plugin/sqlite-admin/table/' . rawurlencode($params['table']) . '/indexes'); ?>" class="df-sqlite-form">

            <label>
                <?=esc_html__('Index Name', $r['id']);?>
                <input type="text" name="index_name" placeholder="<?= esc_html($params['table']); ?>_column_idx" required>
            </label>

            <label class="df-sqlite-checkbox">
                <input type="checkbox" name="unique" value="1">
                <?=esc_html__('Unique index', $r['id']);?>
            </label>

            <fieldset>
                <legend><?=esc_html__('Columns', $r['id']);?></legend>

                <?php foreach ($params['columns'] as $column): ?>
                    <label class="df-sqlite-checkbox">
                        <input type="checkbox" name="columns[]" value="<?= esc_html($column['name']); ?>">
                        <?= esc_html($column['name']); ?>
                        <small><?= esc_html($column['type'] ?? ''); ?></small>
                    </label>
                <?php endforeach; ?>
            </fieldset>

            <button type="submit"><?=esc_html__('Create Index', $r['id']);?></button>
        </form>
    </div>
</section>
<?php }); ?>

