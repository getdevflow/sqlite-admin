    </div>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const textarea = document.querySelector('#sql-editor');
            const pre = document.querySelector('#sql-highlighting');
            const code = document.querySelector('#sql-highlight');

            const syncHighlight = () => {
                if (!textarea || !code) {
                    return;
                }

                code.textContent = textarea.value || ' ';

                if (window.Prism) {
                    Prism.highlightElement(code);
                }
            };

            const syncScroll = () => {
                if (!textarea || !pre) {
                    return;
                }

                pre.scrollTop = textarea.scrollTop;
                pre.scrollLeft = textarea.scrollLeft;
            };

            document.querySelectorAll('.df-sqlite-snippet').forEach((button) => {
                button.addEventListener('click', () => {
                    if (!textarea) {
                        return;
                    }

                    textarea.value = button.dataset.sql || '';
                    syncHighlight();
                    syncScroll();
                    textarea.focus();
                    textarea.setSelectionRange(textarea.value.length, textarea.value.length);
                });
            });

            textarea?.addEventListener('input', syncHighlight);
            textarea?.addEventListener('scroll', syncScroll);

            syncHighlight();
        });
    </script>
