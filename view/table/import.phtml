<?php

use App\Shared\Services\Registry;

use function App\Shared\Helpers\admin_url;
use function Qubus\Security\Helpers\esc_html;
use function Qubus\Security\Helpers\esc_html__;

$this->parent('plugin::SqliteAdmin/view/layout');
$this->block('sqlite-admin', function ($params) {
$r = Registry::getInstance()->get('sqlite-admin');
$columnCount = count($params['columns'] ?? []);
?>

<section class="df-sqlite-card">
    <header class="df-sqlite-card-header">
        <div>
            <h2><?=esc_html__('Import Into Table:', $r['id']);?> <?= esc_html($params['table']); ?></h2>
            <p><?=esc_html__('Import CSV or SQL data into this table.', $r['id']);?></p>
        </div>

        <div class="df-sqlite-actions">
            <a class="button" href="<?= admin_url('plugin/sqlite-admin/table/' . rawurlencode($params['table'])); ?>">
                <?=esc_html__('Browse', $r['id']);?>
            </a>

            <a class="button" href="<?= admin_url('plugin/sqlite-admin/table/' . rawurlencode($params['table']) . '/export'); ?>">
                <?=esc_html__('Export', $r['id']);?>
            </a>
        </div>
    </header>

    <div class="df-sqlite-card-body">
        <div class="df-sqlite-panel">
            <h3><?=esc_html__('Import File', $r['id']);?></h3>

            <form
                    method="post"
                    action="<?= admin_url('sqlite-admin/table/' . rawurlencode($params['table']) . '/import'); ?>"
                    enctype="multipart/form-data"
                    class="df-sqlite-form"
            >

                <label>
                    <?=esc_html__('Import File', $r['id']);?>
                    <input type="file" name="import" accept=".csv,.sql,text/csv,text/sql" required>
                    <small><?=esc_html__('CSV imports are matched by header row. SQL files are executed against this table scope.', $r['id']);?></small>
                </label>

                <label class="df-sqlite-checkbox">
                    <input type="checkbox" name="confirm_import" value="1" required>
                    <span>
                        <strong><?=esc_html__('I understand this import may modify records.', $r['id']);?></strong>
                        <small><?=esc_html__('Export a backup before importing production data.', $r['id']);?></small>
                    </span>
                </label>

                <div class="df-sqlite-form-actions">
                    <button type="submit"><?=esc_html__('Import Table', $r['id']);?></button>
                </div>
            </form>
        </div>

        <div class="df-sqlite-panel">
            <h3><?=esc_html__('Table Information', $r['id']);?></h3>

            <dl class="df-sqlite-meta">
                <dt><?=esc_html__('Table', $r['id']);?></dt>
                <dd><code><?= esc_html($params['table']); ?></code></dd>

                <dt><?=esc_html__('Columns', $r['id']);?></dt>
                <dd><?= esc_html((string) $columnCount); ?></dd>

                <dt><?=esc_html__('CSV Requirements', $r['id']);?></dt>
                <dd><?=esc_html__('First row must contain column names matching this table.', $r['id']);?></dd>
            </dl>
        </div>

        <?php if (($params['columns'] ?? []) !== []): ?>
            <div class="df-sqlite-panel">
                <h3><?=esc_html__('Available Columns', $r['id']);?></h3>

                <div class="df-sqlite-table-wrap">
                    <table class="df-sqlite-grid">
                        <thead>
                        <tr>
                            <th><?=esc_html__('Name', $r['id']);?></th>
                            <th><?=esc_html__('Type', $r['id']);?></th>
                            <th><?=esc_html__('Nullable', $r['id']);?></th>
                            <th><?=esc_html__('Default', $r['id']);?></th>
                            <th><?=esc_html__('Primary Key', $r['id']);?></th>
                        </tr>
                        </thead>

                        <tbody>
                        <?php foreach ($params['columns'] as $column): ?>
                            <tr>
                                <td><strong><?= esc_html((string) ($column['name'] ?? '')); ?></strong></td>
                                <td><?= esc_html((string) ($column['type'] ?? '')); ?></td>
                                <td><?= ! empty($column['notnull']) ? 'No' : 'Yes'; ?></td>
                                <td><?= esc_html((string) ($column['dflt_value'] ?? 'NULL')); ?></td>
                                <td><?= ! empty($column['pk']) ? 'Yes' : 'No'; ?></td>
                            </tr>
                        <?php endforeach; ?>
                        </tbody>
                    </table>
                </div>
            </div>
        <?php endif; ?>
    </div>
</section>
<?php }); ?>

